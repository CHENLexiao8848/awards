@JSP000078.erdos_58 : ∀ {V : Type u_1} (G : SimpleGraph V) (k : ℕ),
  G.oddCycleLengths.Finite →
    G.oddCycleLengths.ncard ≤ k →
      G.chromaticNumber ≤ 2 * ↑k + 2 ∧ (G.chromaticNumber = 2 * ↑k + 2 ↔ completeGraph (Fin (2 * k + 2)) ⊑ G)
