@JSP000078.mem_oddCycleLengths : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V) {n : ℕ},
  n ∈ JSP000078.oddCycleLengths G ↔ Odd n ∧ ∃ v p, p.IsCycle ∧ p.length = n
@JSP000078.chromaticNumber_le_of_card_oddCycleLengths_eq : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V)
  (k : ℕ), (JSP000078.oddCycleLengths G).card = k → G.chromaticNumber ≤ ↑(2 * k + 2)
JSP000078.oddCycleLengths_bound_sharp : ∀ (k : ℕ),
  ∃ G, (JSP000078.oddCycleLengths G).card = k ∧ G.chromaticNumber = ↑(2 * k + 2)
@JSP000078.historicalIncidentChordLemmaTwo : JSP000078.HistoricalIncidentChordLemmaTwo
@JSP000078.historicalBipartiteFanPathLengths : JSP000078.HistoricalBipartiteFanPathLengths
@JSP000078.odd_lengths_of_endpoint_neighbor_sets : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V} {c A B y : V}
  {C : G.Walk c c} {P : G.Walk A B},
  JSP000078.IsLongestOddCycle C →
    P.IsPath →
      A ≠ B →
        Disjoint {v | v ∈ P.support} {v | v ∈ C.support} →
          y ∈ C.support →
            G.Adj B y →
              ∀ (X Z : Finset V),
                X.Nonempty →
                  (∀ v ∈ X, v ∈ C.support ∧ v ≠ y ∧ G.Adj A v) →
                    (∀ v ∈ Z, v ∈ P.support ∧ v ≠ P.getVert 1 ∧ G.Adj A v) →
                      Z.card + (X.card + 1) / 2 ≤ (JSP000078.oddCycleLengths G).card
@JSP000078.complete_of_independent_outside_longest_odd_cycle : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V}
  [inst_1 : DecidableRel G.Adj] (k : ℕ),
  1 ≤ k →
    (∀ (v : V), 2 * k + 1 ≤ G.degree v) →
      (JSP000078.oddCycleLengths G).card = k →
        ∀ {c : V} {C : G.Walk c c},
          JSP000078.IsLongestOddCycle C →
            (∀ (x y : V), x ∉ C.support → y ∉ C.support → ¬G.Adj x y) → G = ⊤ ∧ Fintype.card V = 2 * k + 2
@JSP000078.odd_lengths_of_shared_attachment : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V} {c A B x : V}
  {C : G.Walk c c} {P : G.Walk A B},
  C.IsCycle →
    Odd C.length →
      P.IsPath →
        A ≠ B →
          Disjoint {v | v ∈ P.support} {v | v ∈ C.support} →
            ∀ (X : Finset V) (k : ℕ),
              1 ≤ k →
                X.card = 2 * k →
                  (∀ v ∈ X, v ∈ C.support ∧ G.Adj A v) → x ∈ X → G.Adj B x → k + 1 ≤ (JSP000078.oddCycleLengths G).card
@JSP000078.odd_cycle_length_eq_of_outside_hub : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V} {c v : V}
  {C : G.Walk c c},
  C.IsCycle →
    Odd C.length →
      v ∉ C.support →
        ∀ (X : Finset V) (k : ℕ),
          2 ≤ k →
            X.card = 2 * k →
              (JSP000078.oddCycleLengths G).card = k → (∀ x ∈ X, x ∈ C.support ∧ G.Adj v x) → C.length = 2 * k + 1
@JSP000078.two_large_endpoint_attachment_sets_impossible : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V}
  {c A B : V} {C : G.Walk c c} {P : G.Walk A B},
  C.IsCycle →
    Odd C.length →
      P.IsPath →
        A ≠ B →
          Disjoint {v | v ∈ P.support} {v | v ∈ C.support} →
            ∀ (X Y : Finset V) (k : ℕ),
              1 ≤ k →
                (JSP000078.oddCycleLengths G).card = k →
                  X.card = 2 * k →
                    2 * k ≤ Y.card → (∀ v ∈ X, v ∈ C.support ∧ G.Adj A v) → (∀ v ∈ Y, v ∈ C.support ∧ G.Adj B v) → False
@JSP000078.historicalDistinctEndpointException : JSP000078.HistoricalDistinctEndpointException
@JSP000078.shared_endpoint_edge_exception : ∀ {V : Type u_1} [inst : Fintype V] {G : SimpleGraph V},
  JSP000078.TwoVertexConnected G →
    ∀ {c A B : V} {C : G.Walk c c} {P : G.Walk A B},
      JSP000078.IsLongestOddCycle C →
        P.IsPath →
          2 ≤ P.length →
            Disjoint {v | v ∈ P.support} {v | v ∈ C.support} →
              G.Adj A B →
                ∀ (X : Finset V) (k : ℕ),
                  1 ≤ k →
                    (JSP000078.oddCycleLengths G).card = k →
                      X.card = 2 * k - 1 → (∀ x ∈ X, x ∈ C.support ∧ G.Adj A x ∧ G.Adj B x) → False
