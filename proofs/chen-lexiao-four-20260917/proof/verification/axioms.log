JSP000301.exists_consecutive_powerful_not_square :
  ∃ n, JSP000301.Powerful n ∧ JSP000301.Powerful (n + 1) ∧ ¬IsSquare n ∧ ¬IsSquare (n + 1)
JSP000301.conjecture_false :
  ¬∀ (n : ℕ), JSP000301.Powerful n → JSP000301.Powerful (n + 1) → IsSquare n ∨ IsSquare (n + 1)
'JSP000301.conjecture_false' depends on axioms: [propext, Classical.choice, Quot.sound]
JSP000690.solution :
  ∃ H,
    H.vertices.card = 9 ∧
      Finset.card H.edges = 22 ∧
        JSP000690.IsUniform H.edges 3 ∧
          JSP000690.IsThreeColorCritical H ∧
            (∀ v ∈ H.vertices, 7 ≤ JSP000690.degree H.edges v) ∧ ∃ v ∈ H.vertices, JSP000690.degree H.edges v = 7
JSP000690.every_proper_subgraph_two_colorable (K : JSP000690.FiniteHypergraph)
  (hK : JSP000690.IsProperSubgraph K JSP000690.exampleGraph) : JSP000690.Colorable K.edges 2
'JSP000690.solution' depends on axioms: [propext, Classical.choice, Quot.sound]
