JSP000633.BoundedRepresentations (A : Finset ℕ) (k : ℕ) : Prop
JSP000633.IsSidon (A : Finset ℕ) : Prop
JSP000633.finite_bound (A : Finset ℕ) (k : ℕ) (hk : JSP000633.BoundedRepresentations A k) :
  ∃ B ⊆ A, JSP000633.IsSidon B ∧ ↑A.card ^ 2 ≤ (4 + 24 * ↑k) * ↑B.card ^ 3
JSP000633.sidon_subset_two_thirds (k : ℕ) :
  ∃ c,
    0 < c ∧
      ∀ (A : Finset ℕ),
        JSP000633.BoundedRepresentations A k → ∃ B ⊆ A, JSP000633.IsSidon B ∧ c * ↑A.card ^ (2 / 3) ≤ ↑B.card
JSP000633.answer_sqrt (k : ℕ) (M : ℝ) :
  ∃ N,
    ∀ (A : Finset ℕ),
      N ≤ A.card → JSP000633.BoundedRepresentations A k → ∃ B ⊆ A, JSP000633.IsSidon B ∧ M * √↑A.card < ↑B.card
JSP000633.answer_positive_power (k : ℕ) :
  ∃ N,
    ∀ (A : Finset ℕ),
      N ≤ A.card →
        JSP000633.BoundedRepresentations A k → ∃ B ⊆ A, JSP000633.IsSidon B ∧ ↑A.card ^ (1 / 2 + 1 / 12) < ↑B.card
'JSP000633.finite_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
